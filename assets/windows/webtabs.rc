// Windows resources for webtabs.exe (compiled by build.rs).
// Icon 1 is the app icon Explorer shows; icon 2 is the tray's unread variant.
// Both are generated from assets/webtabs-macos.png, see assets/windows/README.

1 ICON "webtabs.ico"
2 ICON "webtabs-unread.ico"

// RT_MANIFEST (24), CREATEPROCESS_MANIFEST_RESOURCE_ID (1)
1 24 "webtabs.exe.manifest"

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "vaan.dev"
      VALUE "FileDescription", "WebTabs"
      VALUE "FileVersion", "0.1.0"
      VALUE "InternalName", "webtabs"
      VALUE "OriginalFilename", "webtabs.exe"
      VALUE "ProductName", "WebTabs"
      VALUE "ProductVersion", "0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
